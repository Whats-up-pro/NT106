<Window x:Class="ThreeMess.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cuộc gọi" Height="600" Width="800" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CallButton" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="30"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Video/Avatar Area -->
            <Grid Grid.Row="0" Background="#FF1E293B">
                <!-- Group call participants grid -->
                <ItemsControl x:Name="ParticipantsView" ItemsSource="{Binding CallParticipants}"
                              Visibility="{Binding IsGroupCall, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="ParticipantsGrid" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF0F172A" BorderBrush="#FF334155" BorderThickness="1" Margin="4">
                                <Grid>
                                    <!-- Video placeholder -->
                                    <Rectangle Fill="#FF1E293B" />
                                    
                                    <!-- Avatar fallback -->
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#FF475569"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarText}" FontSize="32" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name label -->
                                    <Border Background="#AA000000" CornerRadius="8" Padding="12,6"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 1-1 call view -->
                <Grid Visibility="{Binding IsOneToOneCall, Converter={StaticResource BoolToVis}}">
                    <!-- Remote video/avatar -->
                    <Rectangle Fill="#FF1E293B" />
                    
                    <Border Width="120" Height="120" CornerRadius="60" Background="#FF475569"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemoteAvatarText}" FontSize="48" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Remote user name -->
                    <Border Background="#AA000000" CornerRadius="12" Padding="16,8"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120">
                        <TextBlock Text="{Binding RemoteDisplayName}" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Call status overlay (ringing, connecting, etc.) -->
                <Border Background="#CC000000" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CallStatusText}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="48"
                                   HorizontalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" CenterX="24" CenterY="24" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                           From="0" To="360" Duration="0:0:2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Timer -->
                <Border Background="#AA000000" CornerRadius="8" Padding="12,6"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                        Visibility="{Binding IsCallActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CallDuration}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </Border>

                <!-- Local video preview (bottom-right corner) -->
                <Border Width="160" Height="120" CornerRadius="12" Background="#FF0F172A"
                        BorderBrush="#FF334155" BorderThickness="2"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,120"
                        Visibility="{Binding IsVideoCall, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Rectangle Fill="#FF1E293B" />
                        <TextBlock Text="Bạn" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Control buttons -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="20" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Microphone toggle -->
                    <Button Command="{Binding ToggleMicrophoneCommand}"
                            ToolTip="Tắt/Bật micro">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CallButton}">
                                <Setter Property="Background" Value="#FF64748B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                                        <Setter Property="Background" Value="#FFEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE720;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xEC54;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- End call -->
                    <Button Style="{StaticResource CallButton}" Background="#FFEF4444"
                            Command="{Binding EndCallCommand}"
                            ToolTip="Kết thúc cuộc gọi">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE778;" FontSize="24" Foreground="White" />
                    </Button>

                    <!-- Add participant (group calls only) -->
                    <Button Style="{StaticResource CallButton}" Background="#FF64748B"
                            Command="{Binding AddParticipantCommand}"
                            ToolTip="Thêm người tham gia"
                            Visibility="{Binding CanAddParticipants, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FA;" FontSize="24" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

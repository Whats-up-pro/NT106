<Window x:Class="ThreeMess.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ThreeMess.ViewModels"
        mc:Ignorable="d"
    Title="Quên mật khẩu" Height="420" Width="420" WindowStartupLocation="CenterScreen"
    Background="#FFF5F6F8" Opacity="0" Icon="{DynamicResource AppMark}">

    <Window.DataContext>
        <vm:ForgotPasswordViewModel />
    </Window.DataContext>

    <Grid Margin="18">
        <Border Background="White" CornerRadius="18" Padding="26" BorderBrush="#FFE5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Click="OpenLogin_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8">
                    <TextBlock Text="←" FontSize="18" Foreground="#FF111827" />
                </Button>

                <TextBlock Text="Quên mật khẩu" FontSize="24" FontWeight="SemiBold" Foreground="#FF111827" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Làm theo các bước để khôi phục" Foreground="#FF6B7280" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,18" />

                <!-- Step 0: Enter account email -->
                <StackPanel Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Nhập email tài khoản bạn quên mật khẩu" Foreground="#FF374151" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Email"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Command="{Binding NextCommand}" Height="42" Margin="0,16,0,0"
                            Background="#FF38BDF8" Foreground="White" BorderThickness="0">
                        <TextBlock Text="Tiếp tục" FontWeight="SemiBold" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Step 1: Confirm account -->
                <StackPanel Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Bạn có muốn khôi phục mật khẩu cho tài khoản này?" Foreground="#FF374151" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="{Binding AccountUsername}" Foreground="#FF6B7280" FontSize="12" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Email}" Foreground="#FF6B7280" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ConfirmAccountCommand}" Height="42" Margin="0,16,0,0"
                            Background="#FF38BDF8" Foreground="White" BorderThickness="0">
                        <TextBlock Text="Đúng, khôi phục" FontWeight="SemiBold" FontSize="14" />
                    </Button>

                    <Button Command="{Binding BackCommand}" Height="38" Margin="0,10,0,0"
                            Background="Transparent" Foreground="#FF2563EB" BorderThickness="0">
                        <TextBlock Text="Không phải tài khoản này" FontWeight="SemiBold" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Step 2: Send reset email -->
                <StackPanel Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Chúng tôi sẽ gửi email khôi phục mật khẩu về địa chỉ email của bạn." Foreground="#FF374151" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Email" Foreground="#FF6B7280" FontSize="12" />
                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold" Foreground="#FF111827" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SendResetEmailCommand}" Height="42" Margin="0,16,0,0"
                            Background="#FF38BDF8" Foreground="White" BorderThickness="0">
                        <TextBlock Text="Gửi email khôi phục" FontWeight="SemiBold" FontSize="14" />
                    </Button>
                    <Button Command="{Binding BackCommand}" Height="38" Margin="0,10,0,0"
                            Background="Transparent" Foreground="#FF2563EB" BorderThickness="0">
                        <TextBlock Text="Quay lại" FontWeight="SemiBold" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Step 3: Done -->
                <StackPanel Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Thành công" FontSize="18" FontWeight="SemiBold" Foreground="#FF111827" HorizontalAlignment="Center" Margin="0,6,0,6" />
                    <TextBlock Text="Hãy mở email và làm theo hướng dẫn để đặt lại mật khẩu." Foreground="#FF6B7280" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Click="OpenLogin_Click" Height="42" Margin="0,18,0,0"
                            Background="#FF38BDF8" Foreground="White" BorderThickness="0">
                        <TextBlock Text="Về Login" FontWeight="SemiBold" FontSize="14" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#FFDC2626" Margin="0,12,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>


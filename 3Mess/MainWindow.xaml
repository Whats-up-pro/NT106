<Window x:Class="ThreeMess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeMess"
        xmlns:vm="clr-namespace:ThreeMess.ViewModels"
    xmlns:models="clr-namespace:ThreeMess.Models"
        mc:Ignorable="d"
        Title="MessagingApp" Height="720" Width="1180" MinHeight="640" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}" Icon="{DynamicResource AppMark}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RightSidebarIconToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="BlueSidebarCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightSidebarCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="RightSidebarIconButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightSidebarPillHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PillHeaderBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimarySendButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="999"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarMoreButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border CornerRadius="10" Background="{TemplateBinding Background}" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Margin="2" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:FriendItemViewModel}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Grid Width="40" Height="40" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Presence dot (bottom-right) -->
                    <Ellipse Width="12" Height="12"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,1,1"
                             Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Đang hoạt động">
                                        <Setter Property="Fill" Value="#FF10B981" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE840;"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="6,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="MoreBtn" Style="{StaticResource SidebarMoreButton}" ToolTip="Tùy chọn">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="16" Foreground="#FFEF4444" />
                    </ToggleButton>
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=MoreBtn}"
                           IsOpen="{Binding IsChecked, ElementName=MoreBtn, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel Width="230">
                                <Border Style="{StaticResource MenuRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ghim" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                      IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                      Command="{Binding DataContext.UpdatePinnedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource MenuRow}" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thông báo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                      IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                                      Command="{Binding DataContext.UpdateNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />

                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0"
                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Border Style="{StaticResource MenuRow}">
                                        <TextBlock Text="Xóa cuộc trò chuyện" FontSize="14" FontWeight="SemiBold" Foreground="#FFEF4444" />
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GroupChatItemViewModel}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE840;"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="6,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="Nhóm" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="MoreBtnG" Style="{StaticResource SidebarMoreButton}" ToolTip="Tùy chọn">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="16" Foreground="#FFEF4444" />
                    </ToggleButton>
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=MoreBtnG}"
                           IsOpen="{Binding IsChecked, ElementName=MoreBtnG, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel Width="230">
                                <Border Style="{StaticResource MenuRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ghim" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                      IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                      Command="{Binding DataContext.UpdatePinnedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource MenuRow}" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thông báo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                      IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                                      Command="{Binding DataContext.UpdateNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />

                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0"
                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Border Style="{StaticResource MenuRow}">
                                        <TextBlock Text="Xóa cuộc trò chuyện" FontSize="14" FontWeight="SemiBold" Foreground="#FFEF4444" />
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MemberItemViewModel}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Grid Width="32" Height="32" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding RoleLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RoleLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2" Width="28" Height="28" Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="MemberMore_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Xem trang cá nhân" Command="{Binding ViewProfileCommand}" />
                            <MenuItem Header="Nhắn tin" Command="{Binding MessageCommand}" />
                            <Separator />
                            <MenuItem Header="Kick khỏi nhóm" Command="{Binding KickCommand}"
                                      Visibility="{Binding CanKick, Converter={StaticResource BoolToVis}}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
            <Grid x:Name="MessageRow" Margin="8,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftAvatar" Width="28" Height="28" Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding SenderAvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SenderAvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding SenderAvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SenderAvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel x:Name="BubbleRow" Grid.Column="1" Orientation="Horizontal" Background="Transparent">
                    <!-- Outgoing: action button on the LEFT of bubble -->
                    <Button x:Name="LeftActionButton"
                            Width="28" Height="28"
                            Margin="0,0,6,0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Opacity="0.55"
                            Command="{Binding DataContext.RevokeMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Border x:Name="Bubble" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="14,10" MaxWidth="640">
                        <StackPanel>
                            <TextBlock x:Name="MessageText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" />
                            <Image x:Name="MessageImage"
                                   Source="{Binding Image}"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,6"
                                   MaxWidth="360"
                                   MaxHeight="240"
                                    Stretch="Uniform"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="MessageImage_MouseLeftButtonUp" />

                            <Border x:Name="MessageFile"
                                    Visibility="Collapsed"
                                    Background="#0FFFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="10,0,10,0" VerticalAlignment="Center"
                                               Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Width="70" Height="28" Margin="0"
                                            Background="#33FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"
                                            Foreground="White" Cursor="Hand"
                                            Click="SaveFileButton_Click">
                                        <TextBlock Text="Lưu" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="MessageLink"
                                    Visibility="Collapsed"
                                    Background="#0FFFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="15">
                                    <Hyperlink NavigateUri="{Binding LinkUri}"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="White">
                                        <Run Text="{Binding LinkText}" />
                                    </Hyperlink>
                                </TextBlock>
                            </Border>

                            <TextBlock x:Name="TimeText" Text="{Binding MetaText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Incoming: action button on the RIGHT of bubble (local hide) -->
                    <Button x:Name="RightActionButton"
                            Width="28" Height="28"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Opacity="0.55"
                            Command="{Binding DataContext.HideMessageLocallyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <Grid x:Name="RightAvatar" Grid.Column="2" Width="28" Height="28" Background="Transparent" VerticalAlignment="Bottom" Margin="8,0,0,0" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding SenderAvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SenderAvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding SenderAvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SenderAvatarImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter TargetName="LeftAvatar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RightAvatar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BubbleRow" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#FF7C3AED" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#FF6D28D9" />
                    <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                    <Setter TargetName="TimeText" Property="Foreground" Value="#FFE9D5FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="False">
                    <Setter TargetName="BubbleRow" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Bubble" Property="Background" Value="#FF7C3AED" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#FF6D28D9" />
                    <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                    <Setter TargetName="TimeText" Property="Foreground" Value="#FFE9D5FF" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MessageBubbleKind.Image}">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageImage" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MessageBubbleKind.File}">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageFile" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MessageBubbleKind.Link}">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageFile" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MessageLink" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOutgoing}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=MessageRow}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LeftActionButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RightActionButton" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOutgoing}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=MessageRow}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RightActionButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LeftActionButton" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Left: friends -->
            <Border Grid.Column="0" Style="{StaticResource BlueSidebarCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Normal sidebar (friends/groups) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFriendFinderMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="Bạn bè"
                                Command="{Binding ShowFriendsCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowGroups}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="Nhóm"
                                Command="{Binding ShowGroupsCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowGroups}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Width="28" Height="28" Margin="8,0,0,0"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Tạo group chat"
                                    Command="{Binding OpenCreateGroupCommand}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Tìm kiếm"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="13" VerticalContentAlignment="Center" Padding="0" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="2" Margin="0,12,0,0"
                             ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedSidebarItem}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    </Grid>

                    <!-- Friend finder sidebar -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFriendFinderMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Kết bạn" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,10" />

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Tìm kiếm email hoặc username"
                                         Text="{Binding FriendFinderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13" VerticalContentAlignment="Center" Padding="0" />
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="{Binding FriendFinderStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="2,0,0,8" />

                            <ListBox ItemsSource="{Binding FriendFinderResults}"
                                     SelectedItem="{Binding SelectedFriendFinderUser}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Text="{Binding AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <!-- Single action (Kết bạn/Đã gửi/Bạn bè) -->
                                                <Button Width="72" Height="28"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.SendFriendFinderRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanAction}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="18">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRequestPending}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFriend}" Value="True">
                                                                    <Setter Property="Background" Value="#FF111827" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="BorderBrush" Value="#FF111827" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShowIncomingActions}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"
                                                                   FontSize="12" Margin="0,0,6,0"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFriend}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsRequestPending}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ActionText}" FontSize="12"
                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Incoming request actions (Chấp nhận / Từ chối) -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowIncomingActions}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Button Width="72" Height="28" Margin="0,0,6,0"
                                                            Background="#FF111827" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.AcceptFriendFinderRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="Chấp nhận" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>

                                                    <Button Width="60" Height="28"
                                                            Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                            Command="{Binding DataContext.DeclineFriendFinderRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="12">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="Từ chối" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" CornerRadius="12" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Middle: chat / profile -->
            <Border Grid.Column="1" CornerRadius="16" Background="{DynamicResource ChatBackgroundBrush}" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <!-- Normal chat -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFriendFinderMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProfileMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0">
                            <Ellipse Fill="{DynamicResource SurfaceAltBrush}" />

                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedConversation.AvatarImage}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.AvatarImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="{Binding SelectedConversation.AvatarText, FallbackValue=?}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.AvatarImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue=Tin nhắn}"
                                       FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OtherTypingText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsOtherTyping, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="" />
                    </Grid>

                    <!-- Messages -->
                    <Border Grid.Row="1" Background="Transparent" Padding="6,8">
                        <Grid>
                            <ListBox x:Name="MessagesList" ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Chọn cuộc trò chuyện" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="để bắt đầu nhắn tin" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Input -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="0" Background="{DynamicResource SurfaceBrush}" Click="AttachButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>

                            <TextBox x:Name="DraftBox" Style="{StaticResource WatermarkTextBox}" Tag="Nhập tin nhắn..."
                                     Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center" Padding="2,1" Grid.Column="1" Margin="10,0,0,0" />

                            <Button Grid.Column="2" Style="{StaticResource PrimarySendButton}" Command="{Binding SendMessageCommand}" Margin="10,0,0,0" Width="40" Height="40" Padding="0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" FontSize="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    </Grid>

                    <!-- Profile view (friend finder mode) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFriendFinderMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProfileMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hồ sơ" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,10" />

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="30" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Profile content -->
                                <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="210" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Cover -->
                                <Border Grid.Row="0" CornerRadius="30" Background="#FFE6ECFF" ClipToBounds="True">
                                    <Grid>
                                        <!-- Normal cover -->
                                        <Image Source="{Binding SelectedProfile.CoverImage}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProfile.CoverImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Edit preview cover (drag to reposition) -->
                                        <Rectangle x:Name="EditCoverSurface" Cursor="SizeAll"
                                                   MouseLeftButtonDown="EditCoverSurface_MouseLeftButtonDown"
                                                   MouseMove="EditCoverSurface_MouseMove"
                                                   MouseLeftButtonUp="EditCoverSurface_MouseLeftButtonUp"
                                                   SizeChanged="EditCoverSurface_SizeChanged">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding EditCoverPreview}"
                                                            Stretch="Fill"
                                                            ViewboxUnits="RelativeToBoundingBox"
                                                            Viewbox="{Binding EditCoverViewbox}" />
                                            </Rectangle.Fill>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditCoverPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <!-- Pick cover button (edit mode) -->
                                        <Button Width="34" Height="34" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                Command="{Binding PickMyCoverCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE114;" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Avatar (overlap) -->
                                                                  <Grid x:Name="EditAvatarSurface" Grid.Row="0" Width="120" Height="120" Background="Transparent" Cursor="SizeAll"
                                                                      MouseLeftButtonDown="EditAvatarSurface_MouseLeftButtonDown"
                                                                      MouseMove="EditAvatarSurface_MouseMove"
                                                                      MouseLeftButtonUp="EditAvatarSurface_MouseLeftButtonUp"
                                      VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,-60">
                                    <Grid>
                                        <!-- White ring + base -->
                                        <Ellipse Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="6" />

                                        <!-- Normal avatar image (true circle clip) -->
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding SelectedProfile.AvatarImage}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProfile.AvatarImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Edit preview avatar (true circle clip + drag to reposition) -->
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding EditAvatarPreview}"
                                                            Stretch="Fill"
                                                            ViewboxUnits="RelativeToBoundingBox"
                                                            Viewbox="{Binding EditAvatarViewbox}" />
                                            </Ellipse.Fill>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditAvatarPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Text="{Binding SelectedProfile.AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProfile.AvatarImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Pick avatar button (edit mode) -->
                                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                Command="{Binding PickMyAvatarCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE114;" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Header info -->
                                <StackPanel Grid.Row="1" Margin="20,70,20,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedProfile.Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SelectedProfile.FriendsCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <Grid DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <!-- My profile actions -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsViewingOwnProfile}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- Edit button (not editing) -->
                                                <Button Height="34" MinWidth="168" Padding="12,0" Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        Command="{Binding BeginEditMyProfileCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="Chỉnh sửa trang cá nhân" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Save / Cancel (editing) -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Button Width="86" Height="34" Margin="0,0,8,0" Cursor="Hand"
                                                            Background="#FF111827" BorderThickness="0"
                                                            Command="{Binding SaveMyProfileCommand}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="Lưu" Foreground="White" FontWeight="SemiBold" />
                                                    </Button>

                                                    <Button Width="86" Height="34" Cursor="Hand"
                                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Command="{Binding CancelEditMyProfileCommand}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="Hủy" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Single action -->
                                            <Button Width="98" Height="34"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                    Command="{Binding SendFriendFinderRequestCommand}"
                                                    CommandParameter="{Binding SelectedFriendFinderUser}"
                                                    IsEnabled="{Binding SelectedFriendFinderUser.CanAction}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="18">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsViewingOwnProfile}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedFriendFinderUser.IsRequestPending}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedFriendFinderUser.IsFriend}" Value="True">
                                                                <Setter Property="Background" Value="#FF111827" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="BorderBrush" Value="#FF111827" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedFriendFinderUser.ShowIncomingActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"
                                                               FontSize="12" Margin="0,0,8,0"
                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedFriendFinderUser.IsFriend}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedFriendFinderUser.IsRequestPending}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SelectedFriendFinderUser.ActionText}"
                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Incoming request actions -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsViewingOwnProfile}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedFriendFinderUser.ShowIncomingActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button Width="98" Height="34" Margin="0,0,8,0"
                                                        Background="#FF111827" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding AcceptFriendFinderRequestCommand}"
                                                        CommandParameter="{Binding SelectedFriendFinderUser}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="Chấp nhận" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <Button Width="74" Height="34"
                                                    Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                        Command="{Binding DeclineFriendFinderRequestCommand}"
                                                        CommandParameter="{Binding SelectedFriendFinderUser}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="Từ chối" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </StackPanel>

                                <!-- About -->
                                <Border Grid.Row="2" Margin="20,14,20,0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="About" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                        <!-- Edit bio -->
                                        <TextBox Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}" MinHeight="84" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Text="{Binding SelectedProfile.About}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProfile.About}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Người dùng chưa cập nhật giới thiệu." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingMyProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProfile.About}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding SelectedProfile.StatusText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"
                                                   Visibility="{Binding SelectedProfile.IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <!-- Empty state when no profile selected -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chọn một người dùng" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="để xem hồ sơ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: actions + members (group only) + docs -->
            <Border Grid.Column="2" Style="{StaticResource RightSidebarCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top icons (4 slots: 3 buttons + avatar) -->
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Button Style="{StaticResource RightSidebarIconButton}" Margin="0,0,8,0" ToolTip="Trang chủ" Command="{Binding GoHomeCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                        <Grid Margin="0,0,8,0">
                            <ToggleButton x:Name="NotificationsToggle" Style="{StaticResource RightSidebarIconToggleButton}" ToolTip="Thông báo"
                                          IsChecked="{Binding IsNotificationsPopupOpen, Mode=TwoWay}">
                                <Grid>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding NotificationBellIconGlyph}" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Badge -->
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            Padding="5,1" BorderThickness="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationBadgeText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NotificationBadgeText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="NotificationsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=NotificationsToggle}"
                                IsOpen="{Binding IsNotificationsPopupOpen, Mode=TwoWay}"
                                StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="12" Width="320">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Thông báo" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                          IsChecked="{Binding AreNotificationsEnabled, Mode=TwoWay}" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding Notifications}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8" CornerRadius="10">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <StackPanel>
                                                                    <!-- Click area: open chat/profile depending on Kind -->
                                                                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                                            Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel>
                                                                            <DockPanel LastChildFill="True">
                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="10,1,0,0" />
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <!-- Inline actions for incoming friend requests -->
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="friend_request">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>

                                                                        <Button Content="Từ chối" Padding="10,4" Margin="0,0,8,0" FontSize="12"
                                                                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                                Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"
                                                                                Command="{Binding DataContext.DeclineNotificationFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" />

                                                                        <Button Content="Chấp nhận" Padding="10,4" FontSize="12" Style="{StaticResource PrimarySendButton}"
                                                                                Command="{Binding DataContext.AcceptNotificationFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Chưa có thông báo." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Grid Margin="0,0,8,0">
                            <ToggleButton x:Name="SettingsToggle" Style="{StaticResource RightSidebarIconToggleButton}" ToolTip="Cài đặt">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </ToggleButton>

                            <Popup x:Name="SettingsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsToggle}"
                                   IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   Closed="SettingsPopup_Closed">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="12" Width="240">
                                    <StackPanel>
                                        <TextBlock Text="Cài đặt" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Chế độ tối" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                          IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Trạng thái hoạt động" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ToggleButton Grid.Column="1" Style="{StaticResource SmallSwitch}"
                                                          IsChecked="{Binding IsActivityStatusEnabled, Mode=TwoWay}" />
                                        </Grid>

                                        <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" Height="36"
                                                Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="Trang cá nhân" Command="{Binding OpenMyProfileCommand}"
                                Focusable="False" FocusVisualStyle="{x:Null}" Padding="0" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="999" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Ellipse Fill="{DynamicResource SurfaceBrush}" />

                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding CurrentUserAvatarImage}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentUserAvatarImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Fallback: anonymous person icon when no avatar -->
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentUserAvatarImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>

                    <!-- Second icons row (3 buttons) -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                        <Button Style="{StaticResource RightSidebarIconButton}" Margin="0,0,8,0" ToolTip="Gọi thoại"
                                Command="{Binding StartVoiceCallCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE717;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                        
                        <!-- Bell icon with notification badge and popup -->
                        <Grid Margin="0,0,8,0">
                            <ToggleButton x:Name="NotificationToggle" Style="{StaticResource RightSidebarIconToggleButton}" ToolTip="Thông báo"
                                          IsChecked="{Binding IsNotificationPopupOpen, Mode=TwoWay}">
                                <Grid>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7ED;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    
                                    <!-- Notification badge -->
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FFEF4444"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            Visibility="{Binding HasPendingFriendRequests, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PendingFriendRequestsCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </ToggleButton>

                            <!-- Notification Popup -->
                            <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=NotificationToggle}"
                                   IsOpen="{Binding IsNotificationPopupOpen, Mode=TwoWay}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="12" Width="280" MaxHeight="400">
                                    <StackPanel>
                                        <TextBlock Text="Lời mời kết bạn" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                        <!-- Friend requests list -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="350">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingFriendRequests}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding PendingFriendRequests}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Avatar -->
                                                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Top" Grid.RowSpan="2">
                                                                    <TextBlock Text="{Binding AvatarText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                                                                </Border>

                                                                <!-- Name and subtitle -->
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <!-- Action buttons -->
                                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,8,0,0">
                                                                    <Button Height="28" MinWidth="70" Margin="0,0,6,0"
                                                                            Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Cursor="Hand"
                                                                            Command="{Binding DataContext.AcceptFriendRequestFromNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="10,0">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <TextBlock Text="Chấp nhận" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                                                    </Button>

                                                                    <Button Height="28" MinWidth="60"
                                                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                                                            Command="{Binding DataContext.DeclineFriendRequestFromNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="12" Padding="10,0">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <TextBlock Text="Từ chối" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Empty state -->
                                        <TextBlock Text="Không có lời mời mới" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,20,0,20"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingFriendRequests}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        
                        <Button Style="{StaticResource RightSidebarIconButton}" ToolTip="Kết bạn" Click="RightSidebarFriends_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                    </UniformGrid>

                    <!-- Content (independent scroll areas) -->
                    <StackPanel Grid.Row="2">
                            <!-- Members section (group chat only) -->
                            <StackPanel Visibility="{Binding SelectedConversation.IsGroup, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource RightSidebarPillHeader}" Margin="0,0,0,8">
                                    <TextBlock Text="Thành viên" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>

                                <ListBox ItemsSource="{Binding Members}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MaxHeight="180">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="8" />
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" Margin="0,6,0,12" />
                            </StackPanel>

                            <!-- Docs section (toggle: Tài liệu | Link) -->
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Content="Tài liệu"
                                        Command="{Binding ShowRightDocsCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Left" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="Foreground" Value="#FF6B7280" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="TextElement.FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRightLinks}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF1E3A8A" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="1" Content="Link"
                                        Command="{Binding ShowRightLinksCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Right" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRightLinks}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Docs view (Images/Videos + Files) -->
                            <StackPanel Visibility="{Binding ShowRightDocs, Converter={StaticResource BoolToVis}}">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        Command="{Binding ToggleRightImagesExpandedCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RightSidebarPillHeader}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Hình ảnh &amp; Video" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>

                                <ScrollViewer Visibility="{Binding RightImagesExpanded, Converter={StaticResource BoolToVis}}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="260" Margin="0,0,0,6">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="8" />
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl ItemsSource="{Binding RightImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                        Click="RightSidebarImage_Click">
                                                    <Grid Height="72" Width="72" Margin="0,0,8,8">
                                                        <Ellipse Fill="{DynamicResource InputBackgroundBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        Command="{Binding ToggleRightFilesExpandedCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Style="{StaticResource RightSidebarPillHeader}" Margin="0,6,0,8" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Tệp" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>

                                <ListBox ItemsSource="{Binding RightFiles}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MaxHeight="260"
                                         Visibility="{Binding RightFilesExpanded, Converter={StaticResource BoolToVis}}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="8" />
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                    Click="RightSidebarFile_Click">
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="Bấm để tải" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE896;" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" FontSize="16" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Links view -->
                            <StackPanel Visibility="{Binding ShowRightLinks, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource RightSidebarPillHeader}" Margin="0,0,0,8">
                                    <TextBlock Text="Link" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>

                                <ListBox ItemsSource="{Binding RightLinks}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MaxHeight="420">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="8" />
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                                    <Hyperlink NavigateUri="{Binding Uri}"
                                                               RequestNavigate="Hyperlink_RequestNavigate"
                                                               Foreground="{DynamicResource PrimaryBrush}">
                                                        <Run Text="{Binding Text}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- In-app confirm bar (no separate window) -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"
                Padding="12" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Panel.ZIndex="999"
                Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding ConfirmMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Height="34" MinWidth="84" Margin="0,0,8,0"
                            Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Command="{Binding ConfirmOkCommand}">
                        <TextBlock Text="{Binding ConfirmOkText}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Height="34" MinWidth="84"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                            Command="{Binding ConfirmCancelCommand}">
                        <TextBlock Text="{Binding ConfirmCancelText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- In-app toast -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14"
                Padding="10" Margin="16,0,16,72" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Panel.ZIndex="998"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border Width="6" CornerRadius="999" Background="{Binding ToastAccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core palette (aligned with MessagingApp ThemeService.Dark) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0EA5E9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF22D3EE" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF0F172A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF334155" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF64748B" />

    <SolidColorBrush x:Key="BorderBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF38BDF8" />

    <!-- App-specific tokens (dark adaptation) -->
    <SolidColorBrush x:Key="CardBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF111827" />
    <SolidColorBrush x:Key="PillHeaderBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF7DD3FC" />

    <SolidColorBrush x:Key="InputBorderBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="WatermarkBrush" Color="#FF64748B" />

    <LinearGradientBrush x:Key="ChatBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0F172A" Offset="0" />
        <GradientStop Color="#FF1E293B" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>

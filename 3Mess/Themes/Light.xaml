<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core palette (aligned with MessagingApp ThemeService.Light) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0EA5E9" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF0284C7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF06B6D4" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF1F5F9" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />

    <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF0EA5E9" />

    <!-- App-specific tokens (match existing light design) -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFE6ECFF" />
    <SolidColorBrush x:Key="PillHeaderBrush" Color="#FFDBEAFE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF1E3A8A" />

    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF9FAFB" />
    <SolidColorBrush x:Key="WatermarkBrush" Color="#FF9CA3AF" />

    <LinearGradientBrush x:Key="ChatBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFEBF1F7" Offset="0" />
        <GradientStop Color="#FFE6ECFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
